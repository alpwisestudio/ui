{
  "name": "@alpwise/ui",
  "version": "0.1.0",
  "description": "Design system Alpwise Studio: token CSS, componenti React, preset Tailwind v3 e tema Tailwind v4.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpwise/alpwise-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "fonts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind/preset.d.ts",
      "import": "./dist/tailwind/preset.js",
      "require": "./dist/tailwind/preset.cjs"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./fonts.css": "./styles/fonts.css",
    "./components.css": "./styles/components.css",
    "./motion.css": "./styles/motion.css",
    "./theme.css": "./styles/theme.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
